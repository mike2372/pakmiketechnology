# YouTube Data API v3 Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key_here

# ToyyibPay Configuration (Server-side only - do not expose to client)
# Get your credentials from: https://toyyibpay.com/
# Production category MUST be an 8-character string (e.g. x0hpsb1e), NOT a full URL
TOYYIBPAY_SECRET_KEY=your_toyyibpay_secret_key_here
TOYYIBPAY_CATEGORY_CODE=your_toyyibpay_category_code_here

# Resend Email Configuration
# Get your API key from: https://resend.com/
RESEND_API_KEY=your_resend_api_key_here
ADMIN_EMAIL=your_email@example.com